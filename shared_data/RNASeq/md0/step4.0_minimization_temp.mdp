integrator              = steep
emtol                   = 40.0 ; 1000 5000
nsteps = 95000
nstlist                 = 10
cutoff-scheme           = Verlet
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
;
constraints             = h-bonds
constraint_algorithm    = LINCS
pbc                   = xyz
periodic_molecules    = no
nstxout               = 0
nstvout               = 0
nstenergy             = 1
;
gen-vel                 = yes
gen-temp                = 303.15
gen-seed                = 12345
ld-seed                 = 347715
